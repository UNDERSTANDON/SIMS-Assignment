@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";
    var role     = ViewBag.Role     as string ?? "Admin";
    var username = ViewBag.Username as string ?? "";
    int total_students = ViewBag.TotalStudents ?? 0;
    int total_courses  = ViewBag.TotalCourses  ?? 0;
    int total_enrolled = ViewBag.TotalEnrolled ?? 0;
}

<style>
/* Bento grid layout — exact cell count = content count (Section 4.7) */
.dash-bento {
    display: grid;
    gap: 1rem;
}
/* Admin bento: 4 stat cards + 4 quick access + 1 pattern legend = 9 items */
.stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; }
.quick-grid {
    display: grid;
    /* 4 items → 4 cells, no empty cells */
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
}
.pattern-grid {
    display: grid;
    /* 3 patterns → 3 cells, no empty cells */
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
}
.slide-dot.active {
    background: var(--accent-light) !important;
    transform: scale(1.2);
}
/* Image tile in bento — real visual (Section 4.9: bento background diversity) */
.bento-image-cell {
    grid-column: span 2;
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    position: relative;
    min-height: 160px;
}
.bento-image-cell img {
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.55;
}
.bento-image-cell .bento-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(9,9,11,0.8) 30%, transparent 100%);
    display: flex; align-items: center;
    padding: 1.5rem;
}
.bento-image-cell .bento-kpi {
    font-size: 2.5rem;
    font-weight: 900;
    letter-spacing: -0.05em;
    color: var(--text-primary);
    line-height: 1;
}
.bento-image-cell .bento-kpi-label {
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-weight: 500;
    margin-top: 0.25rem;
}

@@media (max-width: 1024px) {
    .stat-grid  { grid-template-columns: repeat(2, 1fr); }
    .quick-grid { grid-template-columns: repeat(2, 1fr); }
    .pattern-grid { grid-template-columns: repeat(1, 1fr); }
    .bento-image-cell { grid-column: span 1; }
}
@@media (max-width: 640px) {
    .stat-grid  { grid-template-columns: 1fr 1fr; }
    .quick-grid { grid-template-columns: 1fr 1fr; }
}
</style>

<div class="sims-page">
    <!-- Page header — no eyebrow (Section 4.7 eyebrow restraint) -->
    <div class="sims-page-header">
        <h1 class="sims-page-title">
            <i class="fa-solid fa-house fa-sm"></i>
            Dashboard
        </h1>
        <div class="d-flex align-items-center gap-2">
            @{
                var rc = role switch { "Admin" => "role-admin", "Faculty" => "role-faculty", _ => "role-student" };
            }
            <span class="role-badge @rc">@role</span>
            <span class="fs-xs text-muted-sims font-mono">@username</span>
        </div>
    </div>

    <div class="dash-bento">
         
        @if (role == "Admin")
        {
            <!-- STAT CARDS — 4 items, 4 cells (bento cell count rule) -->
            <div class="stat-grid">
                <div class="sims-stat-card" style="position:relative;overflow:hidden;min-height:92px;display:block;">
                    <!-- Slide Container -->
                    <div id="statCarousel" style="height:100%;display:flex;flex-direction:column;justify-content:center;">
                        
                        <!-- Slide 1: Students -->
                        <div class="stat-slide" id="slide-student" style="display:flex;align-items:center;gap:0.75rem;width:100%;">
                            <div class="sims-stat-icon" style="background:var(--accent-ghost)">
                                <i class="fa-solid fa-graduation-cap" style="color:var(--accent-light)"></i>
                            </div>
                            <div>
                                <div class="sims-stat-num" style="color:var(--accent-light)">@total_students</div>
                                <div class="sims-stat-label">Students</div>
                            </div>
                        </div>

                        <!-- Slide 2: Faculty -->
                        <div class="stat-slide" id="slide-faculty" style="display:none;align-items:center;gap:0.75rem;width:100%;">
                            <div class="sims-stat-icon" style="background:var(--success-muted)">
                                <i class="fa-solid fa-chalkboard-user" style="color:#4ade80"></i>
                            </div>
                            <div>
                                <div class="sims-stat-num" style="color:#4ade80">@ViewBag.TotalLecturers</div>
                                <div class="sims-stat-label">Faculty</div>
                            </div>
                        </div>

                        <!-- Slide 3: Admin -->
                        <div class="stat-slide" id="slide-admin" style="display:none;align-items:center;gap:0.75rem;width:100%;">
                            <div class="sims-stat-icon" style="background:rgba(96,165,250,0.1)">
                                <i class="fa-solid fa-user-shield" style="color:#60a5fa"></i>
                            </div>
                            <div>
                                <div class="sims-stat-num" style="color:#60a5fa">@ViewBag.TotalAdmins</div>
                                <div class="sims-stat-label">Administrators</div>
                            </div>
                        </div>

                    </div>

                    <!-- Navigation Dots -->
                    <div style="position:absolute;right:0.75rem;bottom:0.4rem;display:flex;gap:4px;z-index:10;">
                        <button onclick="showSlide(0)" class="slide-dot active" style="width:6px;height:6px;border-radius:50%;border:none;background:var(--border-subtle);cursor:pointer;padding:0;transition:all 0.2s;"></button>
                        <button onclick="showSlide(1)" class="slide-dot" style="width:6px;height:6px;border-radius:50%;border:none;background:var(--border-subtle);cursor:pointer;padding:0;transition:all 0.2s;"></button>
                        <button onclick="showSlide(2)" class="slide-dot" style="width:6px;height:6px;border-radius:50%;border:none;background:var(--border-subtle);cursor:pointer;padding:0;transition:all 0.2s;"></button>
                    </div>
                </div>
                <div class="sims-stat-card">
                    <div class="sims-stat-icon" style="background:var(--success-muted)">
                        <i class="fa-solid fa-book" style="color:#4ade80"></i>
                    </div>
                    <div>
                        <div class="sims-stat-num text-success-sims">@total_courses</div>
                        <div class="sims-stat-label">Courses</div>
                    </div>
                </div>
                <div class="sims-stat-card">
                    <div class="sims-stat-icon" style="background:rgba(124,58,237,0.1)">
                        <i class="fa-solid fa-list-check" style="color:#a78bfa"></i>
                    </div>
                    <div>
                        <div class="sims-stat-num" style="color:#a78bfa">@total_enrolled</div>
                        <div class="sims-stat-label">Enrollments</div>
                    </div>
                </div>
                <div class="sims-stat-card">
                    <div class="sims-stat-icon" style="background:var(--warning-muted)">
                        <i class="fa-solid fa-layer-group" style="color:#fbbf24"></i>
                    </div>
                    <div>
                        <div class="sims-stat-num text-warning-sims">3</div>
                        <div class="sims-stat-label">Design Patterns</div>
                    </div>
                </div>
            </div>

            <!-- QUICK ACCESS GRID — 5 items -->
            <div class="quick-grid" style="grid-template-columns: repeat(5, 1fr);">
                <a asp-controller="Students" asp-action="Index" class="quick-card">
                    <div class="quick-card-border"></div>
                    <i class="fa-solid fa-user-group" style="color:var(--accent-light)"></i>
                    <div class="qc-title">Users</div>
                    <div class="qc-desc">Manage Students & Faculty</div>
                </a>
                <a asp-controller="Courses" asp-action="Index" class="quick-card">
                    <div class="quick-card-border"></div>
                    <i class="fa-solid fa-book" style="color:#4ade80"></i>
                    <div class="qc-title">Courses</div>
                    <div class="qc-desc">Manage Academic Courses</div>
                </a>
                <a asp-controller="Enrollment" asp-action="Index" class="quick-card">
                    <div class="quick-card-border"></div>
                    <i class="fa-solid fa-list-check" style="color:#a78bfa"></i>
                    <div class="qc-title">Enrollments</div>
                    <div class="qc-desc">Class Assignment & Registration</div>
                </a>
                <a asp-controller="Grades" asp-action="Index" class="quick-card">
                    <div class="quick-card-border"></div>
                    <i class="fa-solid fa-star" style="color:#fbbf24"></i>
                    <div class="qc-title">Grades</div>
                    <div class="qc-desc">Gradebook & Transcripts</div>
                </a>
                <a asp-controller="Account" asp-action="CreateUser" class="quick-card">
                    <div class="quick-card-border"></div>
                    <i class="fa-solid fa-user-gear" style="color:#60a5fa"></i>
                    <div class="qc-title">Account</div>
                    <div class="qc-desc">Create Admin / Faculty / Student</div>
                </a>
            </div>

            <!-- PATTERN SECTION -->
            <div class="pattern-grid">
                <!-- Cell 1: Facade Pattern -->
                <div style="position:relative;border-radius:var(--r-lg);overflow:hidden;border:1px solid var(--border-subtle);min-height:140px;background:var(--surface)">
                    <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(37,99,235,0.15),rgba(37,99,235,0.03))"></div>
                    <div style="position:relative;padding:1.25rem;">
                        <span class="pattern-badge pattern-facade mb-2 d-inline-flex">Facade Pattern</span>
                        <div style="font-weight:700;font-size:0.875rem;margin-bottom:0.3rem;">Auto Enrollment</div>
                        <div style="font-size:0.75rem;color:var(--text-tertiary);">AccountService + BillingService + NotificationService execute simultaneously</div>
                    </div>
                </div>
                <!-- Cell 2: Observer Pattern -->
                <div style="position:relative;border-radius:var(--r-lg);overflow:hidden;border:1px solid rgba(217,119,6,0.2);min-height:140px;background:var(--warning-muted)">
                    <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(217,119,6,0.1),transparent)"></div>
                    <div style="position:relative;padding:1.25rem;">
                        <span class="pattern-badge pattern-observer mb-2 d-inline-flex">Observer Pattern</span>
                        <div style="font-weight:700;font-size:0.875rem;margin-bottom:0.3rem;">Grade Notifications</div>
                        <div style="font-size:0.75rem;color:var(--text-tertiary);">Faculty submits grades → Student receives instant notification</div>
                    </div>
                </div>
                <!-- Cell 3: Strategy Pattern -->
                <div style="position:relative;border-radius:var(--r-lg);overflow:hidden;border:1px solid rgba(22,163,74,0.2);min-height:140px;background:var(--success-muted)">
                    <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(22,163,74,0.1),transparent)"></div>
                    <div style="position:relative;padding:1.25rem;">
                        <span class="pattern-badge pattern-strategy mb-2 d-inline-flex">Strategy Pattern</span>
                        <div style="font-weight:700;font-size:0.875rem;margin-bottom:0.3rem;">Flexible Payment</div>
                        <div style="font-size:0.75rem;color:var(--text-tertiary);">Credit Card (2.5%) / Bank Transfer (0%) / E-Wallet (1%)</div>
                    </div>
                </div>
            </div>
        }

        @if (role == "Faculty")
        {
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
                <a asp-controller="Grades" asp-action="Index" class="quick-card" style="text-align:left;">
                    <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.75rem;">
                        <div style="width:40px;height:40px;background:var(--warning-muted);border-radius:var(--r-md);display:flex;align-items:center;justify-content:center;">
                            <i class="fa-solid fa-star" style="color:#fbbf24"></i>
                        </div>
                        <div>
                            <div class="qc-title" style="text-align:left;">Grade Entry</div>
                            <div class="qc-desc" style="text-align:left;">View course list and enter grades</div>
                        </div>
                    </div>
                    <span class="pattern-badge pattern-observer">Observer Pattern</span>
                </a>
                <!-- Image bento cell -->
                <div class="bento-image-cell">
                    <div class="bento-visual-fallback"></div>
                    <div class="bento-overlay">
                        <div>
                            <div class="bento-kpi">24/7</div>
                            <div class="bento-kpi-label">System Active & Uptime</div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (role == "Student")
        {
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
                <a asp-controller="StudentDashboard" asp-action="Index" class="quick-card" style="text-align:left;">
                    <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.75rem;">
                        <div style="width:40px;height:40px;background:var(--accent-ghost);border-radius:var(--r-md);display:flex;align-items:center;justify-content:center;">
                            <i class="fa-solid fa-graduation-cap" style="color:var(--accent-light)"></i>
                        </div>
                        <div>
                            <div class="qc-title" style="text-align:left;">My Transcripts</div>
                            <div class="qc-desc" style="text-align:left;">View grades & semester GPA</div>
                        </div>
                    </div>
                    <span class="pattern-badge pattern-observer">Observer: Grade Updates</span>
                </a>
                <a asp-controller="Payment" asp-action="Index" class="quick-card" style="text-align:left;">
                    <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.75rem;">
                        <div style="width:40px;height:40px;background:var(--success-muted);border-radius:var(--r-md);display:flex;align-items:center;justify-content:center;">
                            <i class="fa-solid fa-credit-card" style="color:#4ade80"></i>
                        </div>
                        <div>
                            <div class="qc-title" style="text-align:left;">Tuition Payment</div>
                            <div class="qc-desc" style="text-align:left;">3 payment methods</div>
                        </div>
                    </div>
                    <span class="pattern-badge pattern-strategy">Strategy Pattern</span>
                </a>
            </div>
        }

    </div><!-- /.dash-bento -->
</div>

@section Scripts {
<script>
    let currentSlideIndex = 0;
    const slides = ['slide-student', 'slide-faculty', 'slide-admin'];

    function changeSlide(index) {
        currentSlideIndex = index;
        slides.forEach((id, idx) => {
            const el = document.getElementById(id);
            if (el) {
                el.style.display = (idx === index) ? 'flex' : 'none';
            }
        });
        const dots = document.querySelectorAll('.slide-dot');
        dots.forEach((dot, idx) => {
            if (idx === index) {
                dot.classList.add('active');
            } else {
                dot.classList.remove('active');
            }
        });
    }

    // Auto slide every 5 seconds
    let slideTimer = setInterval(() => {
        let next = (currentSlideIndex + 1) % slides.length;
        changeSlide(next);
    }, 5000);

    // Global function called by onclick buttons
    window.showSlide = function(index) {
        clearInterval(slideTimer);
        changeSlide(index);
        slideTimer = setInterval(() => {
            let next = (currentSlideIndex + 1) % slides.length;
            changeSlide(next);
        }, 5000);
    }
</script>
}
