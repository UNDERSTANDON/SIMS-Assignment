<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — SIMS</title>
    <meta name="description" content="Hệ thống Quản lý Sinh viên — Student Information Management System" />

    <!-- Bootstrap 5.3 (Section 2.A: "Fast local-business / agency MVP") -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome (Section 3.C: icon library) -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <!-- SIMS Design System v2 -->
    <link rel="stylesheet" href="~/css/sims.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

@{
    var role      = Context.Session.GetString("Role")     ?? "";
    var username  = Context.Session.GetString("Username") ?? "";
    var loggedIn  = !string.IsNullOrEmpty(role);
}

@if (loggedIn)
{
    <!-- Nav: single line desktop, max 60px height (Section 4.7) -->
    <nav class="sims-navbar navbar navbar-expand-lg" style="height:60px">
        <div class="container-fluid gap-3">
            <!-- Brand -->
                <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">
                <span class="brand-dot"></span>
                SIMS
                <span>/ Quản lý Sinh viên</span>
            </a>

            <button class="navbar-toggler border-0 p-1" type="button"
                    data-bs-toggle="collapse" data-bs-target="#simsNav"
                    style="color:var(--text-tertiary)">
                <i class="fa-solid fa-bars fa-sm"></i>
            </button>

            <div class="collapse navbar-collapse" id="simsNav">
                <!-- Role-based nav links (Section 0: role-based routing) -->
                <ul class="navbar-nav me-auto gap-1">

                    @* ADMIN *@
                    @if (role == "Admin")
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "active" : "")"
                               asp-controller="Dashboard" asp-action="Index">
                                <i class="fa-solid fa-house fa-xs"></i> Bảng điều khiển
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Students" ? "active" : "")"
                               asp-controller="Students" asp-action="Index">
                                <i class="fa-solid fa-users fa-xs"></i> Sinh viên
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Courses" ? "active" : "")"
                               asp-controller="Courses" asp-action="Index">
                                <i class="fa-solid fa-book fa-xs"></i> Khóa học
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Enrollment" ? "active" : "")"
                               asp-controller="Enrollment" asp-action="Index">
                                <i class="fa-solid fa-list-check fa-xs"></i> Ghi danh
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Grades" ? "active" : "")"
                               asp-controller="Grades" asp-action="Index">
                                <i class="fa-solid fa-star fa-xs"></i> Điểm số
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "CreateUser" ? "active" : "")"
                               asp-controller="Account" asp-action="CreateUser">
                                <i class="fa-solid fa-user-gear fa-xs"></i> Tạo tài khoản
                            </a>
                        </li>
                    }

                    @* FACULTY *@
                    @if (role == "Faculty")
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Grades" ? "active" : "")"
                               asp-controller="Grades" asp-action="Index">
                                <i class="fa-solid fa-star fa-xs"></i> Cập nhật điểm
                            </a>
                        </li>
                    }

                    @* STUDENT *@
                    @if (role == "Student")
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "StudentDashboard" ? "active" : "")"
                               asp-controller="StudentDashboard" asp-action="Index">
                                <i class="fa-solid fa-graduation-cap fa-xs"></i> Bảng điểm
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Payment" ? "active" : "")"
                               asp-controller="Payment" asp-action="Index">
                                <i class="fa-solid fa-credit-card fa-xs"></i> Học phí
                            </a>
                        </li>
                    }
                </ul>

                <!-- Right: user info -->
                <div class="d-flex align-items-center gap-2 flex-shrink-0">
                    @{
                        var rc = role switch {
                            "Admin"   => "role-admin",
                            "Faculty" => "role-faculty",
                            _         => "role-student"
                        };
                    }
                    <span class="role-badge @rc">@role</span>
                    <span class="font-mono fs-xs text-muted-sims">@username</span>
                    <a asp-controller="Account" asp-action="Logout"
                       class="btn btn-sims-outline btn-sm py-1">
                        <i class="fa-solid fa-arrow-right-from-bracket fa-xs"></i> Thoát
                    </a>
                </div>
            </div>
        </div>
    </nav>
}

<!-- TempData toast alerts — auto-dismiss (Section 4.5: error states) -->
<div id="toastArea" style="position:fixed; top:72px; right:1rem; z-index:9999; display:flex; flex-direction:column; gap:0.5rem; max-width:360px;">
    @if (TempData["Success"] != null)
    {
        <div class="sims-alert sims-alert-success" id="toast-success">
            <i class="fa-solid fa-circle-check"></i>
            <span>@TempData["Success"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="sims-alert sims-alert-danger" id="toast-error">
            <i class="fa-solid fa-circle-xmark"></i>
            <span>@TempData["Error"]</span>
        </div>
    }
</div>

<main style="position:relative; z-index:1;">
    @RenderBody()
</main>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
// Auto-dismiss toasts after 4s with fade (Section 4.5 transient notifications)
document.querySelectorAll('#toastArea > div').forEach(el => {
    setTimeout(() => {
        el.style.transition = 'opacity 0.4s, transform 0.4s';
        el.style.opacity = '0';
        el.style.transform = 'translateX(8px)';
        setTimeout(() => el.remove(), 400);
    }, 4000);
});
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
