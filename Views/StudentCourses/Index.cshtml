@model List<SIMS_WEB.Models.Course>
@{
    ViewData["Title"] = "Student Courses & Registration";
    ViewData["ActivePage"] = "StudentCourses";
    var allCourses = ViewBag.AllCourses as List<SIMS_WEB.Models.Course> ?? new();
    var enrolledCodes = ViewBag.EnrolledCodes as HashSet<string> ?? new();
    var studentId = ViewBag.StudentId as string ?? "";
}

<div class="sims-page">
    <div class="sims-page-header">
        <h1 class="sims-page-title">
            <i class="fa-solid fa-book-bookmark fa-sm"></i>
            Course Catalog & Enrollment
        </h1>
        <span class="pattern-badge pattern-facade">Facade Pattern</span>
    </div>

    <!-- Alert notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="sims-alert sims-alert-success mb-3">
            <i class="fa-solid fa-circle-check fa-sm"></i>
            <span>@TempData["Success"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="sims-alert sims-alert-danger mb-3">
            <i class="fa-solid fa-circle-xmark fa-sm"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- Stat overview cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="sims-stat-card">
                <div class="sims-stat-icon" style="background: rgba(34, 211, 238, 0.15);">
                    <i class="fa-solid fa-graduation-cap" style="color: #22d3ee;"></i>
                </div>
                <div>
                    <div class="sims-stat-num" style="color: #22d3ee;">@Model.Count</div>
                    <div class="sims-stat-label">Enrolled Courses</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="sims-stat-card">
                <div class="sims-stat-icon" style="background: rgba(167, 139, 250, 0.15);">
                    <i class="fa-solid fa-book-open-reader" style="color: #a78bfa;"></i>
                </div>
                <div>
                    <div class="sims-stat-num" style="color: #a78bfa;">@allCourses.Count</div>
                    <div class="sims-stat-label">Total Offered Courses</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="sims-stat-card">
                <div class="sims-stat-icon" style="background: rgba(251, 191, 36, 0.15);">
                    <i class="fa-solid fa-id-card" style="color: #fbbf24;"></i>
                </div>
                <div>
                    <div class="sims-stat-num font-mono" style="font-size: 1.25rem; color: #fbbf24;">@studentId</div>
                    <div class="sims-stat-label">Student ID</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-pills sims-tabs mb-4" id="courseTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="my-courses-tab" data-bs-toggle="tab" data-bs-target="#my-courses" type="button" role="tab">
                <i class="fa-solid fa-bookmark me-1"></i> My Enrolled Courses (@Model.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="catalog-tab" data-bs-toggle="tab" data-bs-target="#catalog" type="button" role="tab">
                <i class="fa-solid fa-plus-circle me-1"></i> Register New Courses (@allCourses.Count)
            </button>
        </li>
    </ul>

    <!-- Tab Contents -->
    <div class="tab-content" id="courseTabsContent">
        <!-- TAB 1: My Enrolled Courses -->
        <div class="tab-pane fade show active" id="my-courses" role="tabpanel">
            @if (!Model.Any())
            {
                <div class="sims-card p-5 text-center">
                    <i class="fa-solid fa-folder-open fa-3x mb-3" style="color: var(--text-tertiary);"></i>
                    <h4>You are not enrolled in any courses yet</h4>
                    <p class="text-muted">Switch to the <strong>Register New Courses</strong> tab to view available classes and enroll!</p>
                    <button class="btn btn-sims-primary mt-2" onclick="document.getElementById('catalog-tab').click();">
                        <i class="fa-solid fa-magnifying-glass me-1"></i> Browse Course Catalog
                    </button>
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var c in Model)
                    {
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="sims-card p-4 h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <span class="badge font-mono" style="background: rgba(34, 211, 238, 0.15); color: #22d3ee; border: 1px solid rgba(34, 211, 238, 0.3);">@c.Code</span>
                                        <span class="badge" style="background: rgba(74, 222, 128, 0.15); color: #4ade80; border: 1px solid rgba(74, 222, 128, 0.3);">
                                            <i class="fa-solid fa-circle-check fa-xs me-1"></i> Active
                                        </span>
                                    </div>
                                    <h4 style="color: #ffffff !important; font-size: 1.15rem; font-weight: 700;">@c.Title</h4>
                                    <div class="fs-xs text-muted mb-3">
                                        <i class="fa-solid fa-user-tie me-1"></i> Instructor: @(string.IsNullOrEmpty(c.Instructor) ? "Unassigned" : c.Instructor)
                                    </div>

                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between fs-xs mb-1" style="color: rgba(255,255,255,0.7);">
                                            <span>Capacity</span>
                                            <span class="font-mono">@c.EnrolledCount / @c.Capacity</span>
                                        </div>
                                        <div class="sims-progress">
                                            <div class="sims-progress-bar @(c.CapacityPercent >= 90 ? "danger" : c.CapacityPercent >= 70 ? "warning" : "")" style="width:@c.CapacityPercent%"></div>
                                        </div>
                                    </div>
                                </div>

                                <div class="pt-3 border-top border-secondary border-opacity-25 d-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@c.Code" class="btn btn-sims-primary flex-fill btn-sm">
                                        <i class="fa-solid fa-folder-open me-1"></i> Course Materials
                                    </a>
                                    <form asp-action="Unenroll" asp-route-id="@c.Code" method="post" onsubmit="return confirm('Are you sure you want to unenroll from @c.Title?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sims-outline btn-sm text-danger border-danger border-opacity-50" title="Unenroll">
                                            <i class="fa-solid fa-arrow-right-from-bracket"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- TAB 2: Course Catalog & Registration -->
        <div class="tab-pane fade" id="catalog" role="tabpanel">
            <!-- Search bar -->
            <div class="sims-card p-3 mb-4">
                <div class="input-group">
                    <span class="input-group-text" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.6);">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                    <input type="text" id="catalogSearch" class="form-control" placeholder="Search available courses by code, title or instructor..." style="background: rgba(255,255,255,0.05); color: #ffffff !important; border: 1px solid rgba(255,255,255,0.1);" onkeyup="filterCatalog();" />
                </div>
            </div>

            <div class="row" id="catalogGrid">
                @foreach (var c in allCourses)
                {
                    bool isEnrolled = enrolledCodes.Contains(c.Code);
                    <div class="col-md-6 col-lg-4 mb-4 catalog-item" data-code="@c.Code.ToLower()" data-title="@c.Title.ToLower()" data-instructor="@c.Instructor.ToLower()">
                        <div class="sims-card p-4 h-100 d-flex flex-column justify-content-between" style="background: rgba(255,255,255,0.03);">
                            <div>
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge font-mono" style="background: rgba(167, 139, 250, 0.15); color: #a78bfa; border: 1px solid rgba(167, 139, 250, 0.3);">@c.Code</span>
                                    @if (isEnrolled)
                                    {
                                        <span class="badge" style="background: rgba(74, 222, 128, 0.15); color: #4ade80; border: 1px solid rgba(74, 222, 128, 0.3);">
                                            <i class="fa-solid fa-check me-1"></i> Enrolled
                                        </span>
                                    }
                                    else if (c.IsFull)
                                    {
                                        <span class="badge" style="background: rgba(248, 113, 113, 0.15); color: #f87171; border: 1px solid rgba(248, 113, 113, 0.3);">
                                            <i class="fa-solid fa-ban me-1"></i> Class Full
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background: rgba(34, 211, 238, 0.15); color: #22d3ee; border: 1px solid rgba(34, 211, 238, 0.3);">
                                            <i class="fa-solid fa-door-open me-1"></i> Open
                                        </span>
                                    }
                                </div>
                                <h4 style="color: #ffffff !important; font-size: 1.15rem; font-weight: 700;">@c.Title</h4>
                                <div class="fs-xs text-muted mb-3">
                                    <i class="fa-solid fa-user-tie me-1"></i> Lecturer: @(string.IsNullOrEmpty(c.Instructor) ? "TBA" : c.Instructor)
                                </div>

                                <div class="mb-3">
                                    <div class="d-flex justify-content-between fs-xs mb-1" style="color: rgba(255,255,255,0.7);">
                                        <span>Available Seats</span>
                                        <span class="font-mono">@c.EnrolledCount / @c.Capacity</span>
                                    </div>
                                    <div class="sims-progress">
                                        <div class="sims-progress-bar @(c.CapacityPercent >= 90 ? "danger" : c.CapacityPercent >= 70 ? "warning" : "")" style="width:@c.CapacityPercent%"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="pt-3 border-top border-secondary border-opacity-25">
                                @if (isEnrolled)
                                {
                                    <a asp-action="Details" asp-route-id="@c.Code" class="btn btn-sims-outline w-100 btn-sm">
                                        <i class="fa-solid fa-folder-open me-1"></i> View Course
                                    </a>
                                }
                                else if (c.IsFull)
                                {
                                    <button class="btn btn-sims-outline w-100 btn-sm" disabled style="opacity: 0.5; cursor: not-allowed;">
                                        <i class="fa-solid fa-lock me-1"></i> Course Full
                                    </button>
                                }
                                else
                                {
                                    <form asp-action="Enroll" asp-route-id="@c.Code" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sims-success w-100 btn-sm">
                                            <i class="fa-solid fa-plus-circle me-1"></i> Register Course
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    function filterCatalog() {
        const query = document.getElementById('catalogSearch').value.toLowerCase().trim();
        const items = document.querySelectorAll('.catalog-item');
        items.forEach(item => {
            const code = item.getAttribute('data-code') || '';
            const title = item.getAttribute('data-title') || '';
            const instructor = item.getAttribute('data-instructor') || '';
            if (code.includes(query) || title.includes(query) || instructor.includes(query)) {
                item.style.display = 'block';
            } else {
                item.style.display = 'none';
            }
        });
    }
</script>
