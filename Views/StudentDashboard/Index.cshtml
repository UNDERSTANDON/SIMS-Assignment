@{
    ViewData["Title"] = "My Transcript & Grades";
    ViewData["ActivePage"] = "StudentDashboard";
    var grades  = ViewBag.Grades  as List<SIMS_WEB.Models.GradeRecord> ?? new();
    var courses = ViewBag.Courses as List<SIMS_WEB.Models.Course>      ?? new();
}

<style>
.gpa-ring {
    width: 100px; height: 100px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    flex-direction: column;
    border: 3px solid var(--accent-light);
    box-shadow: 0 0 24px rgba(37,99,235,0.2);
}
.gpa-number { font-family: 'Geist Mono', monospace; font-size: 1.8rem; font-weight: 900; letter-spacing: -0.05em; line-height: 1; }
.gpa-label  { font-size: 0.6rem; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.1em; margin-top: 2px; }
</style>

<div class="sims-page">
    <div class="sims-page-header">
        <h1 class="sims-page-title">
            <i class="fa-solid fa-graduation-cap fa-sm"></i>
            My Transcript & Grades
        </h1>
        <span class="pattern-badge pattern-observer">Observer Pattern</span>
    </div>

    <!-- Observer notification panel -->
    <div id="notifPanel" class="sims-alert sims-alert-warning mb-3" style="display:none">
        <i class="fa-solid fa-bell fa-sm"></i>
        <div>
            <strong>Observer Pattern:</strong> New grade update detected.
            <a href="/StudentDashboard/Index" style="color:#fbbf24;margin-left:0.5rem">Refresh Page</a>
        </div>
    </div>

    @if (grades.Any())
    {
        double avg = grades.Average(g => g.Score);
        string gpaLabel = avg >= 90 ? "A" : avg >= 80 ? "B" : avg >= 65 ? "C" : avg >= 50 ? "D" : "F";
        string gpaColor = avg >= 80 ? "#4ade80" : avg >= 65 ? "#fbbf24" : avg >= 50 ? "#a78bfa" : "#f87171";
        string gpaGpa   = avg >= 90 ? "4.0" : avg >= 80 ? "3.0" : avg >= 65 ? "2.0" : avg >= 50 ? "1.0" : "0.0";

        <div style="display:grid;grid-template-columns:auto 1fr 1fr 1fr;gap:0.75rem;align-items:center;margin-bottom:1.25rem;">
            <!-- GPA ring visual -->
            <div class="gpa-ring" style="border-color:@gpaColor;box-shadow:0 0 24px @gpaColor + '33'">
                <div class="gpa-number" style="color:@gpaColor">@gpaLabel</div>
                <div class="gpa-label">GPA @gpaGpa</div>
            </div>
            <!-- Stat cards -->
            <div class="sims-stat-card">
                <div class="sims-stat-icon" style="background:var(--accent-ghost)">
                    <i class="fa-solid fa-list-check" style="color:var(--accent-light)"></i>
                </div>
                <div>
                    <div class="sims-stat-num" style="color:var(--accent-light)">@grades.Count</div>
                    <div class="sims-stat-label">Graded Subjects</div>
                </div>
            </div>
            <div class="sims-stat-card">
                <div class="sims-stat-icon" style="background:var(--success-muted)">
                    <i class="fa-solid fa-star" style="color:#4ade80"></i>
                </div>
                <div>
                    <div class="sims-stat-num font-mono" style="color:@gpaColor">@avg.ToString("F1")</div>
                    <div class="sims-stat-label">Average Score</div>
                </div>
            </div>
            <div class="sims-stat-card">
                <div class="sims-stat-icon" style="background:rgba(124,58,237,0.1)">
                    <i class="fa-solid fa-trophy" style="color:#a78bfa"></i>
                </div>
                <div>
                    <div class="sims-stat-num" style="color:#a78bfa">@grades.Count(g => g.Score >= 80)</div>
                    <div class="sims-stat-label">Subjects &ge; 80%</div>
                </div>
            </div>
        </div>
    }

    <div class="sims-card">
        <div class="sims-card-header">
            <i class="fa-solid fa-chart-bar" style="color:#fbbf24"></i>
            Course Grades
        </div>

        @if (!grades.Any())
        {
            <div class="sims-empty py-4">
                <i class="fa-solid fa-chart-bar"></i>
                <div class="em-title">No Grades Recorded</div>
                <div class="em-sub">Lecturers will post grades and you will receive notifications automatically via the Observer Pattern.</div>
            </div>
        }
        else
        {
            <div class="sims-table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Subject / Course</th>
                            <th class="text-center">Score</th>
                            <th class="text-center">Grade</th>
                            <th style="min-width:140px">Performance</th>
                            <th>Updated At</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in grades)
                        {
                            var course = courses.FirstOrDefault(c => c.Code == g.CourseCode);
                            var scoreColor = g.Score >= 80 ? "#4ade80" : g.Score >= 65 ? "#fbbf24" : g.Score >= 50 ? "#a78bfa" : "#f87171";
                            var barClass   = g.Score >= 80 ? "" : g.Score >= 65 ? "warning" : "danger";
                            <tr>
                                <td>
                                    <div style="font-weight:600;font-size:0.875rem">@(course?.Title ?? g.CourseCode)</div>
                                    <div class="fs-xs text-muted-sims font-mono">@g.CourseCode</div>
                                </td>
                                <td class="text-center font-mono fw-800" style="font-size:1.15rem;color:@scoreColor">@g.Score</td>
                                <td class="text-center">
                                    <span class="sims-badge @g.GradeBadgeClass">@g.GradeLabel</span>
                                </td>
                                <td>
                                    <div class="sims-progress mb-1">
                                        <div class="sims-progress-bar @barClass" style="width:@g.Score%"></div>
                                    </div>
                                    <span class="fs-xs text-muted-sims font-mono">@g.Score / 100</span>
                                </td>
                                <td class="fs-xs text-muted-sims font-mono">@g.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
let lastCount = @grades.Count;
async function checkUpdates() {
    try {
        const r = await fetch('/StudentDashboard/CheckUpdates?count=' + lastCount);
        if (r.ok) {
            const d = await r.json();
            if (d.hasNew) {
                document.getElementById('notifPanel').style.display = 'flex';
                lastCount = d.count;
            }
        }
    } catch(e) {}
}
setInterval(checkUpdates, 15000);
</script>
}
