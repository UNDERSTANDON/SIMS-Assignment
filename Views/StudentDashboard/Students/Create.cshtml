@model SIMS_WEB.Models.Student
@{
    bool isEdit = !string.IsNullOrEmpty(Model?.StudentId);
    ViewData["Title"] = isEdit ? "Sửa Sinh viên" : "Thêm Sinh viên";
    ViewData["ActivePage"] = "Students";
    var programs = new[] {
        "-- Chọn chương trình --",
        "Công nghệ Thông tin", "Kỹ thuật Phần mềm", "Khoa học Máy tính",
        "Quản trị Kinh doanh", "Kỹ thuật Điện tử", "Toán - Tin học"
    };
}

<div class="sims-page" style="max-width:700px">
    <div class="sims-page-header">
        <h1 class="sims-page-title">
            <i class="fa-solid @(isEdit ? "fa-pen" : "fa-user-plus")"></i>
            @(isEdit ? "Sửa thông tin Sinh viên" : "Thêm Sinh viên mới")
        </h1>
        <a asp-action="Index" class="btn btn-sims-outline">
            <i class="fa-solid fa-arrow-left"></i> Quay lại
        </a>
    </div>

    <div class="sims-card">
        <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
            @Html.AntiForgeryToken()

            <!-- Student ID -->
            <div class="mb-3">
                <label asp-for="StudentId" class="form-label"></label>
                @if (isEdit) {
                    <input asp-for="StudentId" class="form-control" readonly />
                } else {
                    <input asp-for="StudentId" class="form-control" placeholder="VD: SV2024005" />
                }
                <span asp-validation-for="StudentId" class="invalid-feedback d-block"></span>
                @if (isEdit)
                {
                    <div class="fs-xs text-muted-sims mt-1">
                        <i class="fa-solid fa-lock fa-xs"></i> Mã sinh viên không thể thay đổi
                    </div>
                }
            </div>

            <!-- Full Name -->
            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" placeholder="VD: Nguyễn Văn An" />
                <span asp-validation-for="FullName" class="invalid-feedback d-block"></span>
            </div>

            <!-- Program -->
            <div class="mb-3">
                <label asp-for="Program" class="form-label"></label>
                <select asp-for="Program" class="form-select">
                    @foreach (var p in programs)
                    {
                        <option value="@(p.StartsWith("--") ? "" : p)"
                                selected="@(Model?.Program == p ? "selected" : null)">@p</option>
                    }
                </select>
                <span asp-validation-for="Program" class="invalid-feedback d-block"></span>
            </div>

            <!-- Email -->
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="email@univ.edu" />
                <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
            </div>

            <!-- Date of Birth -->
            <div class="mb-4">
                <label asp-for="DateOfBirth" class="form-label"></label>
                <input asp-for="DateOfBirth" type="date" class="form-control" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-sims-primary">
                    <i class="fa-solid fa-floppy-disk"></i>
                    @(isEdit ? "Lưu thay đổi" : "Thêm sinh viên")
                </button>
                <a asp-action="Index" class="btn btn-sims-outline">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
