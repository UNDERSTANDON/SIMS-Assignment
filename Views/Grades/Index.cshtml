@model SIMS_WEB.Models.GradeViewModel
@{
    ViewData["Title"] = "Grade Management";
    ViewData["ActivePage"] = "Grades";
}

<style>
.grade-grid {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 1rem;
    align-items: start;
}
@@media (max-width: 900px) { .grade-grid { grid-template-columns: 1fr; } }

.grade-letter {
    width: 56px; height: 56px;
    border-radius: var(--r-lg);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Geist Mono', monospace;
    font-size: 1.4rem; font-weight: 900;
    flex-shrink: 0;
}
</style>

<div class="sims-page">
    <div class="sims-page-header">
        <h1 class="sims-page-title">
            <i class="fa-solid fa-star fa-sm"></i>
            Grade Management
        </h1>
        <div class="d-flex align-items-center gap-2">
            <span class="pattern-badge pattern-observer">Observer Pattern</span>
        </div>
    </div>

    <!-- Alert notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="sims-alert sims-alert-success mb-3">
            <i class="fa-solid fa-circle-check fa-sm"></i>
            <span>@TempData["Success"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="sims-alert sims-alert-danger mb-3">
            <i class="fa-solid fa-circle-xmark fa-sm"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <div class="grade-grid">
        <!-- LEFT: Course Filter & Grade Form -->
        <div class="d-flex flex-column gap-3">
            <!-- Course Selector -->
            <div class="sims-card">
                <div class="sims-card-header text-primary-sims">
                    <i class="fa-solid fa-book-bookmark"></i>
                    Select Course
                </div>
                <div class="mb-2">
                    <select id="courseSelect" class="form-select" onchange="location.href='?courseCode=' + this.value">
                        <option value="">-- Select Course --</option>
                        @foreach (var c in Model.Courses)
                        {
                            <!option value="@c.Code" @(Model.CourseCode == c.Code ? "selected" : "")>
                                @c.Code - @c.Title
                            </!option>
                        }
                    </select>
                </div>
            </div>

            <!-- Grade Update Form -->
            <div class="sims-card">
                <div class="sims-card-header">
                    <i class="fa-solid fa-star" style="color:#fbbf24"></i>
                    Grade Entry / Update
                </div>

                @if (!string.IsNullOrEmpty(Model.EditStudentId))
                {
                    <!-- Observer info -->
                    <div class="sims-alert sims-alert-warning mb-3" style="font-size:0.78rem;">
                        <i class="fa-solid fa-bolt fa-xs"></i>
                        <span><strong>Observer Pattern:</strong> Saving grades automatically sends a real-time notification to the student</span>
                    </div>

                    <form asp-action="Save" asp-controller="Grades" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="CourseCode" />
                        <input type="hidden" asp-for="StudentId" value="@Model.EditStudentId" />

                        <div class="mb-3">
                            <label class="form-label text-muted">Selected Course</label>
                            <input class="form-control" value="@Model.CourseCode" readonly style="background-color: var(--bg); cursor: not-allowed;" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted">Student</label>
                            <input class="form-control" value="@Model.EditStudentName (@Model.EditStudentId)" readonly style="background-color: var(--bg); cursor: not-allowed;" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Score (0 - 100)</label>
                            <input asp-for="Score" type="number" class="form-control font-mono"
                                   min="0" max="100" step="0.5" placeholder="0 - 100"
                                   oninput="previewGrade(this.value)" id="Score" />
                            <span asp-validation-for="Score" class="invalid-feedback d-block"></span>
                        </div>

                        <!-- Grade preview -->
                        <div id="gradePreview" style="display:none;margin-bottom:1rem;">
                            <div style="display:flex;align-items:center;gap:0.75rem;background:var(--surface-2);border:1px solid var(--border-subtle);border-radius:var(--r-md);padding:0.75rem;">
                                <div class="grade-letter" id="gradeLetterBox"></div>
                                <div>
                                    <div id="gradeLabel" style="font-weight:700;font-size:0.875rem;"></div>
                                    <div id="gradeGPA" class="fs-xs text-muted-sims font-mono" style="margin-top:0.1rem;"></div>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-sims-warning w-100">
                            <i class="fa-solid fa-floppy-disk fa-xs"></i> Save Grade & Notify Student
                        </button>
                    </form>
                }
                else
                {
                    <div class="text-center py-4 text-muted-sims" style="font-size:0.875rem;">
                        <i class="fa-solid fa-info-circle fa-2x mb-2" style="color:var(--accent-light);"></i>
                        <p class="mb-0">Select <strong>Edit</strong> on a student row in the table to enter or update grade.</p>
                    </div>
                }
            </div>
        </div>

        <!-- RIGHT: Student List for Selected Course -->
        <div class="sims-card">
            <div class="sims-card-header">
                <i class="fa-solid fa-users" style="color:var(--accent-light)"></i>
                Student Roster
                @if (!string.IsNullOrEmpty(Model.CourseCode))
                {
                    <span class="sims-badge badge-warning ms-auto font-mono">Course: @Model.CourseCode (@Model.Students.Count)</span>
                }
            </div>

            @if (string.IsNullOrEmpty(Model.CourseCode))
            {
                <div class="sims-empty py-4">
                    <i class="fa-solid fa-graduation-cap"></i>
                    <div class="em-title">No course selected</div>
                    <div class="em-sub">Please select a course from the dropdown on the left to manage student grades.</div>
                </div>
            }
            else if (!Model.Students.Any())
            {
                <div class="sims-empty py-4">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <div class="em-title">No enrolled students</div>
                    <div class="em-sub">There are currently no students enrolled in this course.</div>
                </div>
            }
            else
            {
                <div class="sims-table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Full Name</th>
                                <th>Student ID</th>
                                <th class="text-center">Score</th>
                                <th class="text-center">Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.Students)
                            {
                                var gradeRecord = Model.RecentGrades.FirstOrDefault(g => g.CourseCode == Model.CourseCode && g.StudentId == s.StudentId);
                                var scoreText = gradeRecord != null ? gradeRecord.Score.ToString() : "-";
                                var statusText = "Not Graded";
                                var statusClass = "bg-secondary text-white";
                                if (gradeRecord != null)
                                {
                                    if (gradeRecord.Score >= 50)
                                    {
                                        statusText = "Pass";
                                        statusClass = "sims-badge badge-success";
                                    }
                                    else
                                    {
                                        statusText = "Fail";
                                        statusClass = "sims-badge badge-danger";
                                    }
                                }
                                var scoreColor = gradeRecord != null ? (gradeRecord.Score >= 80 ? "#4ade80" : gradeRecord.Score >= 65 ? "#fbbf24" : gradeRecord.Score >= 50 ? "#a78bfa" : "#f87171") : "var(--text-muted)";
                                <tr>
                                    <td>@s.FullName</td>
                                    <td><code>@s.StudentId</code></td>
                                    <td class="text-center font-mono fw-800" style="color:@scoreColor;font-size:1.05rem">@scoreText</td>
                                    <td class="text-center">
                                        <span class="sims-badge @statusClass">@statusText</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1">
                                            <a class="btn btn-sims-outline btn-sm" asp-action="Index" asp-route-courseCode="@Model.CourseCode" asp-route-editStudentId="@s.StudentId">
                                                <i class="fa-solid fa-pen-to-square fa-xs"></i> Edit
                                            </a>
                                            <div class="dropdown">
                                                <button class="btn btn-sims-outline-danger btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="fa-solid fa-trash fa-xs"></i> Delete
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                    <li>
                                                        <form asp-action="DeleteGrade" asp-controller="Grades" method="post" onsubmit="return confirmDeleteGrade()">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="courseCode" value="@Model.CourseCode" />
                                                            <input type="hidden" name="studentId" value="@s.StudentId" />
                                                            <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2">
                                                                <i class="fa-solid fa-eraser fa-xs"></i> Delete grade
                                                            </button>
                                                        </form>
                                                    </li>
                                                    <li>
                                                        <form asp-action="DeleteStudent" asp-controller="Grades" method="post" onsubmit="return confirmDeleteStudent()">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="courseCode" value="@Model.CourseCode" />
                                                            <input type="hidden" name="studentId" value="@s.StudentId" />
                                                            <button type="submit" class="dropdown-item text-danger fw-bold d-flex align-items-center gap-2">
                                                                <i class="fa-solid fa-user-minus fa-xs"></i> Unenroll student
                                                            </button>
                                                        </form>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
const grades = [
    { min: 90, max: 100, label: 'A - Excellent',  gpa: '4.0',  color: '#4ade80', bg: 'rgba(22,163,74,0.12)' },
    { min: 80, max: 89,  label: 'B - Good',       gpa: '3.0',  color: '#60a5fa', bg: 'rgba(37,99,235,0.12)' },
    { min: 65, max: 79,  label: 'C - Average',    gpa: '2.0',  color: '#fbbf24', bg: 'rgba(217,119,6,0.12)' },
    { min: 50, max: 64,  label: 'D - Below Avg',  gpa: '1.0',  color: '#a78bfa', bg: 'rgba(124,58,237,0.12)' },
    { min: 0,  max: 49,  label: 'F - Fail',       gpa: '0.0',  color: '#f87171', bg: 'rgba(220,38,38,0.12)' },
];

function previewGrade(val) {
    const score = parseFloat(val);
    const preview = document.getElementById('gradePreview');
    if (isNaN(score) || val === '') { preview.style.display = 'none'; return; }
    const g = grades.find(x => score >= x.min && score <= x.max) || grades[4];
    document.getElementById('gradeLetterBox').textContent = g.label[0];
    document.getElementById('gradeLetterBox').style.background = g.bg;
    document.getElementById('gradeLetterBox').style.color = g.color;
    document.getElementById('gradeLabel').textContent = g.label;
    document.getElementById('gradeLabel').style.color = g.color;
    document.getElementById('gradeGPA').textContent = 'GPA: ' + g.gpa;
    preview.style.display = 'block';
}

// Initial preview load if value is present
document.addEventListener('DOMContentLoaded', function() {
    const scoreInput = document.getElementById('Score');
    if (scoreInput && scoreInput.value) {
        previewGrade(scoreInput.value);
    }
});

function confirmDeleteGrade() {
    return confirm("Are you sure you want to delete this student's grade record?");
}

function confirmDeleteStudent() {
    return confirm("Are you sure you want to unenroll this student from the course?");
}
</script>
}
