@model CourseEnrollmentsViewModel
@{
    ViewData["Title"] = "Enrolled Students";
}

<div class="sims-page">
    <div class="sims-page-header">
        <h1 class="sims-page-title">Enrolled Students: @Model.Course.Title (<code>@Model.Course.Code</code>)</h1>
    </div>

    <div class="sims-card p-3">
        <div class="mb-3">
            <h5>Total Enrolled Students: <strong>@Model.EnrollmentCount / @Model.Course.Capacity</strong></h5>
            <p class="text-muted">Capacity Usage: @Model.Course.CapacityPercent%</p>
        </div>

        @if (Model.EnrolledStudents.Any())
        {
            <div class="sims-table-wrap">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th style="color: #ffffff !important; width: 60px;"></th>
                            <th style="color: #ffffff !important;">Student ID</th>
                            <th style="color: #ffffff !important;">Full Name</th>
                            <th style="color: #ffffff !important;">Email</th>
                            <th style="color: #ffffff !important;">Academic Program</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in Model.EnrolledStudents.OrderBy(s => s.StudentId))
                        {
                            var stuAvatarFile = "/Account/GetAvatar?id=" + student.StudentId;
                            var stuAvatarPath = System.IO.Path.Combine(SIMS_WEB.Storage.ModelFilePersistence.DataDir, "ProfilePictures", student.StudentId + ".png");
                            var stuHasAvatar = System.IO.File.Exists(stuAvatarPath);
                            <tr>
                                <td>
                                    @if (stuHasAvatar)
                                    {
                                        <img src="@stuAvatarFile" alt="Avatar" style="width:36px; height:36px; border-radius:50%; object-fit:cover; border: 2px solid rgba(255,255,255,0.15);" />
                                    }
                                    else
                                    {
                                        <div style="width:36px; height:36px; border-radius:50%; background:rgba(99,102,241,0.15); border:2px solid rgba(99,102,241,0.3); display:flex; align-items:center; justify-content:center;">
                                            <i class="fa-solid fa-user" style="color:#818cf8; font-size:0.85rem;"></i>
                                        </div>
                                    }
                                </td>
                                <td style="color: #e2e8f0 !important;"><code style="color: #fbbf24 !important;">@student.StudentId</code></td>
                                <td style="color: #ffffff !important; font-weight: 500;">@student.FullName</td>
                                <td style="color: #e2e8f0 !important;">@student.Email</td>
                                <td style="color: #e2e8f0 !important;">@student.Program</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i>
                No students enrolled in this course yet.
            </div>
        }

        <a asp-action="Index" class="btn btn-sims-outline mt-3">Back</a>
    </div>
</div>
