@{
    ViewData["Title"] = "Faculty - Courses";
}

<h2>My Courses</h2>

@if (TempData["Error"] != null)
{
    <div class="sims-alert sims-alert-danger mb-3">
        <i class="fa-solid fa-circle-xmark fa-sm"></i>
        <span>@TempData["Error"]</span>
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="sims-alert sims-alert-success mb-3">
        <i class="fa-solid fa-circle-check fa-sm"></i>
        <span>@TempData["Success"]</span>
    </div>
}

<div class="sims-table-wrap">
    <table class="table">
        <thead>
            <tr>
                <th>Course Name</th>
                <th>Course Code</th>
                <th>Instructor</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var c in Model)
            {
                <tr>
                    <td>@c.Title</td>
                    <td><code>@c.Code</code></td>
                    <td>@c.Instructor</td>
                    <td>
                        <a class="btn btn-sims-outline btn-sm" asp-action="Manage" asp-route-id="@c.Code">Manage</a>
                        <a class="btn btn-sims-primary btn-sm ms-2" asp-action="Enrollments" asp-route-courseCode="@c.Code">Students</a>
                        <a class="btn btn-sims-success btn-sm ms-2" asp-action="CourseAssignments" asp-route-courseCode="@c.Code">Assignments</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

