@model SIMS_WEB.Models.PaymentViewModel
@{
    ViewData["Title"] = "Tuition & Fee Payment";
    ViewData["ActivePage"] = "Payment";
}

<style>
.payment-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 1rem;
    align-items: start;
}
@@media (max-width: 900px) { .payment-layout { grid-template-columns: 1fr; } }

.strategy-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin-bottom: 1.25rem;
}
.strategy-tile {
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: 0.875rem 0.5rem;
    cursor: pointer;
    transition: all 200ms;
    background: var(--surface-2);
    text-align: center;
}
.strategy-tile:hover { border-color: var(--accent-light); }
.strategy-tile.active-blue   { border-color: var(--accent-light); background: var(--accent-ghost); box-shadow: 0 0 0 1px var(--accent-ring); }
.strategy-tile.active-green  { border-color: #22c55e; background: rgba(22,163,74,0.08); box-shadow: 0 0 0 1px rgba(22,163,74,0.2); }
.strategy-tile.active-purple { border-color: #a78bfa; background: rgba(124,58,237,0.08); box-shadow: 0 0 0 1px rgba(124,58,237,0.2); }

.strategy-tile i   { font-size: 1.25rem; display: block; margin-bottom: 0.4rem; }
.strategy-tile .st-name  { font-size: 0.72rem; font-weight: 700; }
.strategy-tile .st-fee   { font-size: 0.65rem; color: var(--text-tertiary); font-family: 'Geist Mono', monospace; margin-top: 0.1rem; }

.order-panel {
    position: sticky;
    top: 80px;
}
.order-line {
    display: flex; justify-content: space-between; align-items: center;
    padding: 0.5rem 0;
    font-size: 0.825rem;
    border-bottom: 1px solid var(--border-subtle);
}
.order-line:last-of-type { border-bottom: none; }
.order-total {
    display: flex; justify-content: space-between; align-items: center;
    padding-top: 0.75rem;
    margin-top: 0.25rem;
    border-top: 1px solid var(--border);
}
</style>

<div class="sims-page">
    <div class="sims-page-header">
        <h1 class="sims-page-title">
            <i class="fa-solid fa-credit-card fa-sm"></i>
            Tuition & Fee Payment
        </h1>
        <span class="pattern-badge pattern-strategy">Strategy Pattern</span>
    </div>

    @if (Model.IsSuccess)
    {
        <div class="sims-alert sims-alert-success mb-4">
            <i class="fa-solid fa-circle-check fa-lg"></i>
            <div>
                <div style="font-weight:600;">Payment Successful!</div>
                <div class="fs-xs" style="margin-top:0.2rem;">@Model.Message</div>
            </div>
        </div>
    }

    <div class="payment-layout">
        <!-- LEFT: Form -->
        <div>
            <form asp-action="Process" asp-controller="Payment" method="post" id="payForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Method" id="methodInput" value="@Model.Method" />

                <!-- Strategy Pattern selector -->
                <div class="sims-card mb-3">
                    <div class="sims-card-header">
                        <i class="fa-solid fa-shuffle" style="color:#4ade80"></i>
                        Select Payment Method
                        <span class="fs-xs text-muted-sims ms-auto font-mono">Strategy Pattern</span>
                    </div>

                    <div class="strategy-grid">
                        <div class="strategy-tile @(Model.Method == "credit" ? "active-blue" : "")"
                             id="tile-credit" onclick="selectMethod('credit')">
                            <i class="fa-solid fa-credit-card" style="color:var(--accent-light)"></i>
                            <div class="st-name">Credit Card</div>
                            <div class="st-fee">2.5% Fee</div>
                        </div>
                        <div class="strategy-tile @(Model.Method == "bank" ? "active-green" : "")"
                             id="tile-bank" onclick="selectMethod('bank')">
                            <i class="fa-solid fa-building-columns" style="color:#4ade80"></i>
                            <div class="st-name">Bank Transfer</div>
                            <div class="st-fee">No Fee</div>
                        </div>
                        <div class="strategy-tile @(Model.Method == "ewallet" ? "active-purple" : "")"
                             id="tile-ewallet" onclick="selectMethod('ewallet')">
                            <i class="fa-solid fa-wallet" style="color:#a78bfa"></i>
                            <div class="st-name">E-Wallet</div>
                            <div class="st-fee">1.0% Fee</div>
                        </div>
                    </div>

                    <!-- Strategy note -->
                    <div id="strategyNote" class="sims-alert sims-alert-info" style="font-size:0.78rem;">
                        <i class="fa-solid fa-code fa-xs"></i>
                        <span id="strategyNoteText">Credit Card: 2.5% transaction processing fee applied</span>
                    </div>
                </div>

                <!-- Credit card form -->
                <div id="form-credit" class="sims-card mb-3" style="display:@(Model.Method == "credit" ? "block" : "none")">
                    <div class="sims-card-header">
                        <i class="fa-solid fa-credit-card" style="color:var(--accent-light)"></i>
                        Card Information
                    </div>
                    <div class="mb-3">
                        <label class="form-label">CARD NUMBER</label>
                        <input name="CardNumber" class="form-control font-mono" placeholder="1234 5678 9012 3456" maxlength="19" oninput="formatCard(this)" />
                    </div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;">
                        <div>
                            <label class="form-label">EXPIRATION DATE</label>
                            <input name="CardExpiry" class="form-control font-mono" placeholder="MM/YY" maxlength="5" />
                        </div>
                        <div>
                            <label class="form-label">CVV</label>
                            <input name="CardCvv" class="form-control font-mono" placeholder="123" maxlength="3" type="password" />
                        </div>
                    </div>
                </div>

                <!-- Bank transfer form -->
                <div id="form-bank" class="sims-card mb-3" style="display:@(Model.Method == "bank" ? "block" : "none")">
                    <div class="sims-card-header">
                        <i class="fa-solid fa-building-columns" style="color:#4ade80"></i>
                        Bank Transfer Details
                    </div>
                    <div class="mb-3">
                        <label class="form-label">BANK NAME</label>
                        <select name="BankName" class="form-select">
                            <option>Vietcombank</option><option>BIDV</option>
                            <option>Agribank</option><option>Techcombank</option>
                            <option>VPBank</option><option>MB Bank</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">ACCOUNT NUMBER</label>
                        <input name="AccountNumber" class="form-control font-mono" placeholder="0123456789" />
                    </div>
                    <div style="background:var(--bg-subtle);border:1px solid var(--border-subtle);border-radius:var(--r-md);padding:0.75rem;font-size:0.78rem;">
                        <div class="font-mono fs-xs text-muted-sims mb-2" style="letter-spacing:0.08em;">RECIPIENT INFORMATION</div>
                        <div style="color:var(--text-secondary);line-height:1.8;">
                            <span class="text-muted-sims">Bank:</span> <strong>Vietcombank</strong><br/>
                            <span class="text-muted-sims">Acc No:</span> <strong class="font-mono">0123456789</strong><br/>
                            <span class="text-muted-sims">Account Holder:</span> <strong>ABC UNIVERSITY</strong><br/>
                            <span class="text-muted-sims">Reference:</span> <strong class="font-mono">Tuition + Student ID</strong>
                        </div>
                    </div>
                </div>

                <!-- E-wallet form -->
                <div id="form-ewallet" class="sims-card mb-3" style="display:@(Model.Method == "ewallet" ? "block" : "none")">
                    <div class="sims-card-header">
                        <i class="fa-solid fa-wallet" style="color:#a78bfa"></i>
                        E-Wallet Options
                    </div>
                    <div class="mb-3">
                        <label class="form-label">SELECT WALLET</label>
                        <select name="WalletType" class="form-select">
                            <option>MoMo</option><option>ZaloPay</option>
                            <option>VNPay</option><option>ShopeePay</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label">PHONE NUMBER / WALLET ID</label>
                        <input name="WalletId" class="form-control font-mono" placeholder="0912 345 678" />
                    </div>
                </div>

                <button type="submit" class="btn btn-sims-primary w-100" style="font-size:0.9rem;padding:0.65rem !important;justify-content:center;" id="payBtn">
                    <i class="fa-solid fa-lock fa-xs"></i>
                    Pay <span id="btnAmount" class="font-mono">15,000,000 VND</span>
                </button>
                <div style="text-align:center;font-size:0.7rem;color:var(--text-tertiary);margin-top:0.5rem;font-family:'Geist Mono',monospace;">
                    SSL 256-bit encrypted
                </div>
            </form>
        </div>

        <!-- RIGHT: Order summary -->
        <div class="order-panel">
                <div class="sims-card">
                <div class="sims-card-header">
                    <i class="fa-solid fa-receipt" style="color:#fbbf24"></i>
                    Payment Invoice
                </div>
                <div class="order-line">
                    <span style="color:var(--text-tertiary)">Semester Tuition</span>
                    <span class="font-mono" style="font-weight:600">15,000,000</span>
                </div>
                <div class="order-line">
                    <span style="color:var(--text-tertiary)">Transaction Fee</span>
                    <span id="feeDisplay" class="font-mono" style="color:#fbbf24">375,000 (2.5%)</span>
                </div>
                <div class="order-total">
                    <span style="font-weight:700">Total Amount</span>
                    <span id="totalDisplay" class="font-mono fw-800" style="font-size:1.1rem;color:var(--accent-light)">15,375,000 VND</span>
                </div>

                <div style="margin-top:1rem;padding-top:0.75rem;border-top:1px solid var(--border-subtle)">
                    <div class="font-mono fs-xs text-muted-sims mb-2" style="letter-spacing:0.08em;">3 STRATEGIES</div>
                    <div style="display:flex;flex-direction:column;gap:0.3rem;font-size:0.75rem;">
                        <div style="display:flex;justify-content:space-between;"><span style="color:var(--accent-light)">Credit Strategy</span><span class="font-mono text-muted-sims">+2.5%</span></div>
                        <div style="display:flex;justify-content:space-between;"><span style="color:#4ade80">Bank Transfer Strategy</span><span class="font-mono text-muted-sims">+0%</span></div>
                        <div style="display:flex;justify-content:space-between;"><span style="color:#a78bfa">E-Wallet Strategy</span><span class="font-mono text-muted-sims">+1.0%</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const BASE = 15000000;
const strategies = {
    credit:  { rate: 0.025, label: '2.5%',  tileClass: 'active-blue',   note: 'Credit Card: 2.5% transaction processing fee applied' },
    bank:    { rate: 0,     label: '0%',    tileClass: 'active-green',  note: 'Bank Transfer: 0% transaction fee' },
    ewallet: { rate: 0.01,  label: '1.0%',  tileClass: 'active-purple', note: 'E-Wallet: 1.0% transaction processing fee applied' },
};
let current = '@Model.Method' || 'credit';

function fmt(n) { return n.toLocaleString('en-US'); }

function selectMethod(method) {
    current = method;
    document.getElementById('methodInput').value = method;
    // Tiles
    Object.keys(strategies).forEach(k => {
        document.getElementById('tile-' + k).className =
            'strategy-tile' + (k === method ? ' ' + strategies[k].tileClass : '');
    });
    // Forms
    ['credit','bank','ewallet'].forEach(k => {
        document.getElementById('form-' + k).style.display = k === method ? 'block' : 'none';
    });
    // Totals
    const s = strategies[method];
    const fee = BASE * s.rate, total = BASE + fee;
    document.getElementById('feeDisplay').textContent = fmt(fee) + ' (' + s.label + ')';
    document.getElementById('totalDisplay').textContent = fmt(total) + ' VND';
    document.getElementById('btnAmount').textContent = fmt(total) + ' VND';
    document.getElementById('strategyNoteText').textContent = s.note;
}

function formatCard(input) {
    let v = input.value.replace(/\D/g, '');
    input.value = v.match(/.{1,4}/g)?.join(' ') || v;
}

// Init
selectMethod(current);
</script>
}
