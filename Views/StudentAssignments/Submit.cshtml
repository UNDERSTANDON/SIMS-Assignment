@model SIMS_WEB.Controllers.SubmitViewModel
@{
    ViewData["Title"] = "Nộp bài";
}

<div class="sims-page">
    <div class="sims-page-header">
        <h1 class="sims-page-title">Nộp bài: @Model.Assignment.Title</h1>
    </div>

    <div class="sims-card p-3">
        <form asp-action="Submit" method="post" enctype="multipart/form-data">
            <input type="hidden" name="assignmentId" value="@Model.Assignment.Id" />
            <div class="mb-3">
                <label class="form-label">Sinh viên</label>
                <select name="studentId" class="form-select">
                    <option value="">-- Chọn sinh viên --</option>
                    @foreach(var s in Model.Students)
                    {
                        <option value="@s.StudentId">@s.FullName (@s.StudentId)</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Nội dung / liên kết</label>
                <textarea name="content" class="form-control" rows="6"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Tệp đính kèm (tuỳ chọn)</label>
                <input type="file" name="file" class="form-control" />
            </div>
            <button class="btn btn-sims-primary">Nộp bài</button>
            <a asp-action="Index" class="btn btn-sims-outline ms-2">Hủy</a>
        </form>
    </div>
</div>
