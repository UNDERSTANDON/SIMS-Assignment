@model SIMS_WEB.Controllers.StudentAssignmentsViewModel
@{
    ViewData["Title"] = "Bài t?p - Sinh viên";
}

<div class="sims-page">
    <div class="sims-page-header">
        <h1 class="sims-page-title">Bài t?p ?ã ???c giao</h1>
    </div>

    <div class="sims-card p-3 mb-3">
        <form method="get" class="row gy-2 gx-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Sinh viên</label>
                <select name="studentId" class="form-select">
                    <option value="">-- Ch?n sinh viên --</option>
                    @foreach(var s in Model.Students)
                    {
                        if (s.StudentId == Model.StudentId)
                        {
                            <option value="@s.StudentId" selected="selected">@s.FullName (@s.StudentId)</option>
                        }
                        else
                        {
                            <option value="@s.StudentId">@s.FullName (@s.StudentId)</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-sims-primary">L?c</button>
            </div>
        </form>
    </div>

    <div class="sims-card p-3">
        @if (!Model.Assignments.Any())
        {
            <div>Không có bài t?p nào. Ch?n sinh viên ?? th?y các bài t?p ?ã giao.</div>
        }
        else
        {
            <ul>
                @foreach(var a in Model.Assignments)
                {
                    var course = Model.Courses.FirstOrDefault(c => c.Code == a.CourseCode);
                    <li class="mb-2">
                        <strong>@a.Title</strong> <span class="text-muted">(@course?.Title ?? a.CourseCode)</span>
                        <div class="text-muted">H?n n?p: @a.DueDate.ToString("g")</div>
                        <div class="mt-1">
                            <a asp-action="Submit" asp-route-courseCode="@a.CourseCode" asp-route-assignmentId="@a.Id" class="btn btn-sims-outline btn-sm">N?p bài</a>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</div>
