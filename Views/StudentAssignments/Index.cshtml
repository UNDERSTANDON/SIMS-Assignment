@model SIMS_WEB.Controllers.StudentAssignmentsViewModel
@{
    ViewData["Title"] = "Student Assignments";
}

<div class="sims-page">
    <div class="sims-page-header">
        <h1 class="sims-page-title">
            <i class="fa-solid fa-file-signature fa-sm"></i>
            Assigned Tasks & Homework
        </h1>
        <a asp-controller="StudentCourses" asp-action="Index" class="btn btn-sims-outline">
            <i class="fa-solid fa-arrow-left fa-xs"></i> Back
        </a>
    </div>

    <!-- Alert notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="sims-alert sims-alert-success mb-3">
            <i class="fa-solid fa-circle-check fa-sm"></i>
            <span>@TempData["Success"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="sims-alert sims-alert-danger mb-3">
            <i class="fa-solid fa-circle-xmark fa-sm"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <div class="sims-card p-3">
        @if (!Model.Assignments.Any())
        {
            <div style="color: #ffffff !important; opacity: 0.7;" class="text-center py-4">
                <i class="fa-solid fa-folder-open fa-2x mb-2 d-block" style="opacity: 0.5;"></i>
                No assignments assigned to you.
            </div>
        }
        else
        {
            <ul class="list-unstyled mb-0">
                @foreach(var a in Model.Assignments)
                {
                    var course = Model.Courses.FirstOrDefault(c => c.Code == a.CourseCode);
                    <li class="mb-3 p-3 rounded" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong style="color: #ffffff !important; font-size: 1.1rem;">@a.Title</strong>
                                <span class="badge ms-2" style="background: rgba(255, 255, 255, 0.15); color: #ffffff !important; font-size: 0.75rem;">
                                    @course?.Title (@a.CourseCode)
                                </span>
                            </div>
                            <span class="fs-xs font-mono" style="color: #ffffff !important; opacity: 0.85;">Due Date: @a.DueDate.ToString("g")</span>
                        </div>
                        <div class="fs-sm mt-2 mb-3" style="color: #ffffff !important; opacity: 0.8;">@a.Description</div>
                        <div>
                            <a asp-action="Submit" asp-route-courseCode="@a.CourseCode" asp-route-assignmentId="@a.Id" class="btn btn-sims-primary btn-sm">
                                <i class="fa-solid fa-paper-plane fa-xs me-1"></i> Submit Work
                            </a>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</div>
