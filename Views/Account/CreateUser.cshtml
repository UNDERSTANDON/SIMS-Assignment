@model SIMS_WEB.Models.CreateUserViewModel
@{
    ViewData["Title"] = "Create User Account";
    ViewData["ActivePage"] = "CreateUser";
}

<div class="sims-page" style="max-width:720px">
    <div class="sims-page-header">
        <h1 class="sims-page-title">
            <i class="fa-solid fa-user-gear"></i> Create User Account
        </h1>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-sims-outline">
            <i class="fa-solid fa-arrow-left"></i> Dashboard
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="sims-alert @(Model.IsSuccess ? "sims-alert-success" : "sims-alert-danger") mb-4">
            <i class="fa-solid @(Model.IsSuccess ? "fa-circle-check" : "fa-circle-xmark")"></i>
            <span>@Model.Message</span>
        </div>
    }

    <div class="sims-card">
        <div class="sims-card-header">
            <i class="fa-solid fa-id-card text-accent"></i>
            New Account Information
        </div>

        <form asp-action="CreateUser" asp-controller="Account" method="post" onreset="setTimeout(onRoleChange, 10)">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Username</label>
                    <input asp-for="Username" class="form-control font-mono" placeholder="e.g. user001" id="usernameInput" />
                    <span asp-validation-for="Username" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Full Name</label>
                    <input asp-for="FullName" class="form-control" placeholder="Full name" />
                    <span asp-validation-for="FullName" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" placeholder="email@univ.edu" />
                    <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Role</label>
                    <select asp-for="Role" class="form-select" id="roleSelect" onchange="onRoleChange()">
                        <option value="Student">Student</option>
                        <option value="Faculty">Faculty</option>
                        <option value="Admin">Admin</option>
                    </select>
                    <span asp-validation-for="Role" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-12">
                    <label class="form-label">Password</label>
                    <input asp-for="Password" class="form-control" placeholder="At least 6 characters" />
                    <span asp-validation-for="Password" class="invalid-feedback d-block"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-sims-primary">
                    <i class="fa-solid fa-user-plus"></i> Create User
                </button>
                <button type="reset" class="btn btn-sims-outline">Reset</button>
            </div>
        </form>
    </div>

    <div class="sims-alert sims-alert-info mt-4">
        <i class="fa-solid fa-circle-info"></i>
        <span>Info: Accounts are securely and persistently stored in the system database (users.csv).</span>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const nextStudentId = '@ViewBag.NextStudentId';
        const nextLecturerId = '@ViewBag.NextLecturerId';

        function onRoleChange() {
            const role = document.getElementById('roleSelect').value;
            const input = document.getElementById('usernameInput');
            if (role === 'Student') {
                input.value = nextStudentId;
                input.readOnly = true;
                input.style.backgroundColor = 'var(--bg)';
                input.style.cursor = 'not-allowed';
            } else if (role === 'Faculty') {
                input.value = nextLecturerId;
                input.readOnly = true;
                input.style.backgroundColor = 'var(--bg)';
                input.style.cursor = 'not-allowed';
            } else {
                // Keep the input value if it's already there (e.g. on validation reload), otherwise empty it
                if (input.value.startsWith('SV') || input.value.startsWith('GV')) {
                    input.value = '';
                }
                input.readOnly = false;
                input.style.backgroundColor = '';
                input.style.cursor = '';
            }
        }

        // Run on load
        onRoleChange();
    </script>
}
