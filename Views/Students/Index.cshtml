@model List<SIMS_WEB.Models.Student>
@{
    ViewData["Title"] = "User Management";
    ViewData["ActivePage"] = "Students";
}

<style>
.search-bar { max-width: 380px; }
.avatar-lg {
    width: 32px; height: 32px;
    border-radius: 50%;
    background: var(--accent-ghost);
    border: 1px solid var(--accent-ring);
    display: inline-flex; align-items: center; justify-content: center;
    font-family: 'Geist Mono', monospace;
    font-size: 0.68rem; font-weight: 700;
    color: var(--accent-light);
    flex-shrink: 0;
}
</style>

<div class="sims-page">
    <div class="sims-page-header">
        <h1 class="sims-page-title">
            <i class="fa-solid fa-user-group fa-sm"></i>
            User Management
        </h1>
        <div class="d-flex gap-2">
            @if (ViewBag.Tab == "faculty")
            {
                <a href="/Account/CreateUser?role=Faculty" class="btn btn-sims-success">
                    <i class="fa-solid fa-plus fa-xs"></i> Add Faculty
                </a>
            }
            else
            {
                <a asp-action="Create" class="btn btn-sims-primary">
                    <i class="fa-solid fa-plus fa-xs"></i> Add Student
                </a>
                <button class="btn btn-sims-outline" onclick="toggleImport()" id="importToggleBtn">
                    <i class="fa-solid fa-file-csv fa-xs"></i> Import CSV
                </button>
            }
        </div>
    </div>

    <!-- Tabs Navigation -->
    <div style="display:flex;gap:0.5rem;margin-bottom:1.5rem;border-bottom:1px solid var(--border-subtle);padding-bottom:0.5rem;">
        <a href="?tab=student&search=@ViewBag.Search" 
           style="padding:0.5rem 1rem;border-radius:var(--r-md);font-size:0.875rem;font-weight:600;text-decoration:none;transition:all var(--dur);color:@(ViewBag.Tab != "faculty" ? "var(--accent-light)" : "var(--text-tertiary)");background:@(ViewBag.Tab != "faculty" ? "var(--accent-ghost)" : "transparent");border:1px solid @(ViewBag.Tab != "faculty" ? "var(--accent-ring)" : "transparent")">
            <i class="fa-solid fa-graduation-cap"></i> Students
            <span class="sims-badge badge-primary ms-1">@ViewBag.StudentsCount</span>
        </a>
        <a href="?tab=faculty&search=@ViewBag.Search" 
           style="padding:0.5rem 1rem;border-radius:var(--r-md);font-size:0.875rem;font-weight:600;text-decoration:none;transition:all var(--dur);color:@(ViewBag.Tab == "faculty" ? "var(--accent-light)" : "var(--text-tertiary)");background:@(ViewBag.Tab == "faculty" ? "var(--accent-ghost)" : "transparent");border:1px solid @(ViewBag.Tab == "faculty" ? "var(--accent-ring)" : "transparent")">
            <i class="fa-solid fa-chalkboard-user"></i> Faculty
            <span class="sims-badge badge-success ms-1">@ViewBag.LecturersCount</span>
        </a>
    </div>

    <!-- CSV Import Panel (only for students) -->
    @if (ViewBag.Tab != "faculty")
    {
        <div id="importPanel" class="sims-card mb-4" style="display:none">
            <div class="sims-card-header">
                <i class="fa-solid fa-cloud-arrow-up" style="color:#4ade80"></i>
                Import List from CSV File
            </div>
            <form asp-action="ImportCsv" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="file-upload-area mb-3"
                     onclick="document.getElementById('csvFile').click()"
                     ondragover="event.preventDefault(); this.classList.add('drag-over')"
                     ondragleave="this.classList.remove('drag-over')"
                     ondrop="handleDrop(event)">
                    <i class="fa-solid fa-cloud-arrow-up mb-2 d-block"></i>
                    <div style="font-weight:600;font-size:0.875rem;">Drag and drop CSV file here</div>
                    <div style="font-size:0.75rem;color:var(--text-tertiary);margin-top:0.25rem;">
                        or <span style="color:var(--accent-light)">select file from computer</span>
                    </div>
                    <div style="font-size:0.7rem;color:var(--muted);margin-top:0.5rem;font-family:'Geist Mono',monospace;">
                        Format: StudentID, FullName, Program, Email
                    </div>
                    <input type="file" id="csvFile" name="csvFile" accept=".csv" class="d-none"
                           onchange="updateFileName(this)" />
                </div>
                <div id="fileNameDisplay" class="font-mono fs-xs text-muted-sims mb-3" style="min-height:1.2rem"></div>
                <div style="background:var(--bg-subtle);border:1px solid var(--border-subtle);border-radius:var(--r-md);padding:0.65rem 0.875rem;margin-bottom:1rem;font-size:0.75rem;font-family:'Geist Mono',monospace;color:var(--text-tertiary)">
                    SV2024005,Nguyen Thi E,Computer Science,e.nt@@univ.edu
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-sims-success">
                        <i class="fa-solid fa-upload fa-xs"></i> Upload & Import
                    </button>
                    <button type="button" class="btn btn-sims-outline" onclick="toggleImport()">Cancel</button>
                </div>
            </form>
        </div>
    }

    <!-- Search bar Cyber Glow Neumorphic -->
    <form method="get" class="mb-3">
        <input type="hidden" name="tab" value="@ViewBag.Tab" />
        <div class="sims-search-box">
            <div class="sims-search-input-wrap">
                <input type="text" name="search" value="@ViewBag.Search"
                       class="sims-search-input" placeholder="Search by name, email..." />
                @if (!string.IsNullOrEmpty(ViewBag.Search?.ToString()))
                {
                    <a href="?tab=@ViewBag.Tab" class="sims-search-icon-btn me-1" title="Clear search" style="background:rgba(220,38,38,0.12);border-color:rgba(220,38,38,0.25);color:#f87171;">
                        <i class="fa-solid fa-xmark fa-xs"></i>
                    </a>
                }
                <button class="sims-search-icon-btn" type="submit" title="Search">
                    <i class="fa-solid fa-magnifying-glass fa-xs"></i>
                </button>
            </div>
        </div>
    </form>

    <!-- Table or empty state -->
    @if (ViewBag.Tab == "faculty")
    {
        var lecturers = (List<SIMS_WEB.Models.Student>)ViewBag.Lecturers;
        @if (lecturers == null || !lecturers.Any())
        {
            <div class="sims-card">
                <div class="sims-empty">
                    <i class="fa-solid fa-users-slash"></i>
                    <div class="em-title">No faculty members found</div>
                    <div class="em-sub">
                        @if (!string.IsNullOrEmpty(ViewBag.Search?.ToString()))
                        {
                            <span>No results for "<strong>@ViewBag.Search</strong>". Try clearing search filters.</span>
                        }
                        else
                        {
                            <span>No faculty members in the system yet.</span>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="sims-table-wrap">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Full Name</th>
                            <th>Faculty ID</th>
                            <th>Email</th>
                            <th>Assigned Courses</th>
                            <th class="text-center" style="width:100px">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in lecturers)
                        {
                            var initials = string.Join("", l.FullName.Split(' ').Where(x => x.Length > 0)
                                               .TakeLast(2).Select(x => x[0]));
                            var avatarUrl = "/Account/GetAvatar?id=" + l.StudentId;
                            var avatarPath = System.IO.Path.Combine(SIMS_WEB.Storage.ModelFilePersistence.DataDir, "ProfilePictures", l.StudentId + ".png");
                            var hasAvatar = System.IO.File.Exists(avatarPath);
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (hasAvatar)
                                        {
                                            <img src="@avatarUrl" alt="Avatar" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 1px solid var(--accent-ring);" />
                                        }
                                        else
                                        {
                                            <div class="avatar-lg" style="background:rgba(34,197,94,0.1);border-color:rgba(34,197,94,0.3);color:#4ade80">
                                                @initials.ToUpper()
                                            </div>
                                        }
                                        <span style="font-weight:600">@l.FullName</span>
                                    </div>
                                </td>
                                <td class="font-mono" style="font-size:0.8rem">@l.StudentId</td>
                                <td style="color:var(--text-secondary);font-size:0.8rem">@l.Email</td>
                                <td>
                                    @{
                                        var courseList = l.Program?.Split('|', StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>();
                                    }
                                    @if (courseList.Length == 0 || (courseList.Length == 1 && courseList[0] == "null"))
                                    {
                                        <select class="form-select form-select-sm" style="max-width:180px;background-color:var(--bg-card);border-color:var(--border-subtle);color:var(--text-secondary);font-size:0.75rem;cursor:not-allowed;" disabled>
                                            <option>None</option>
                                        </select>
                                    }
                                    else if (courseList.Length == 1)
                                    {
                                        <select class="form-select form-select-sm" style="max-width:180px;background-color:var(--bg-card);border-color:var(--border-subtle);color:var(--text-primary);font-size:0.75rem;">
                                            <option>@courseList[0]</option>
                                            <option disabled style="color:var(--text-muted);font-style:italic;">None</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <select class="form-select form-select-sm" style="max-width:180px;background-color:var(--bg-card);border-color:var(--border-subtle);color:var(--text-primary);font-size:0.75rem;">
                                            @foreach (var course in courseList)
                                            {
                                                <option>@course</option>
                                            }
                                        </select>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        <button class="btn-sims-delete-anim" title="Delete Account"
                                                onclick="confirmDeleteUser('@l.StudentId')">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-2 fs-xs text-muted-sims font-mono">
                Showing @lecturers.Count / @ViewBag.LecturersCount faculty members
            </div>
        }
    }
    else
    {
        @if (!Model.Any())
        {
            <div class="sims-card">
                <div class="sims-empty">
                    <i class="fa-solid fa-users-slash"></i>
                    <div class="em-title">No students found</div>
                    <div class="em-sub">
                        @if (!string.IsNullOrEmpty(ViewBag.Search?.ToString()))
                        {
                            <span>No results for "<strong>@ViewBag.Search</strong>". Try clearing search filters.</span>
                        }
                        else
                        {
                            <span>No students registered yet. Add your first student or import from CSV.</span>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="sims-table-wrap">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Student ID</th>
                            <th>Program</th>
                            <th>Email</th>
                            <th class="text-center" style="width:100px">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            var initials = string.Join("", s.FullName.Split(' ').Where(x => x.Length > 0)
                                                .TakeLast(2).Select(x => x[0]));
                            var avatarUrl = "/Account/GetAvatar?id=" + s.StudentId;
                            var avatarPath = System.IO.Path.Combine(SIMS_WEB.Storage.ModelFilePersistence.DataDir, "ProfilePictures", s.StudentId + ".png");
                            var hasAvatar = System.IO.File.Exists(avatarPath);
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (hasAvatar)
                                        {
                                            <img src="@avatarUrl" alt="Avatar" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 1px solid var(--accent-ring);" />
                                        }
                                        else
                                        {
                                            <div class="avatar-lg">@initials.ToUpper()</div>
                                        }
                                        <span style="font-weight:600">@s.FullName</span>
                                    </div>
                                </td>
                                <td><code class="font-mono" style="color:var(--accent-light);font-size:0.8rem">@s.StudentId</code></td>
                                <td>
                                    <span class="sims-badge badge-purple">@s.Program</span>
                                </td>
                                <td style="color:var(--text-tertiary);font-size:0.8rem">@s.Email</td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-action="Edit" asp-route-id="@s.StudentId"
                                           class="btn btn-sims-outline btn-sm py-1 px-2">
                                            <i class="fa-solid fa-pen fa-xs"></i>
                                        </a>
                                        <button class="btn-sims-delete-anim" title="Delete Student"
                                                onclick="confirmDelete('@s.StudentId', '@s.FullName')">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-2 fs-xs text-muted-sims font-mono">
                Showing @Model.Count / @ViewBag.StudentsCount students
            </div>
        }
    }
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-body p-4">
                <div style="width:40px;height:40px;background:var(--danger-muted);border-radius:var(--r-md);display:flex;align-items:center;justify-content:center;margin-bottom:1rem;">
                    <i class="fa-solid fa-trash" style="color:#f87171;font-size:1rem;"></i>
                </div>
                <div style="font-weight:700;font-size:0.95rem;margin-bottom:0.4rem;">Confirm Delete</div>
                <div id="deleteMsg" style="font-size:0.8rem;color:var(--text-tertiary);margin-bottom:1.25rem;"></div>
                <div class="d-flex gap-2">
                    <form id="deleteForm" method="post" class="flex-grow-1">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sims-danger w-100">Delete</button>
                    </form>
                    <button class="btn btn-sims-outline" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function toggleImport() {
    const p = document.getElementById('importPanel');
    if (p) {
        const open = p.style.display !== 'none';
        p.style.display = open ? 'none' : 'block';
    }
}
function updateFileName(input) {
    document.getElementById('fileNameDisplay').textContent =
        input.files[0] ? input.files[0].name + ' (' + (input.files[0].size / 1024).toFixed(1) + ' KB)' : '';
}
function handleDrop(e) {
    e.preventDefault(); e.currentTarget.classList.remove('drag-over');
    const file = e.dataTransfer.files[0];
    const input = document.getElementById('csvFile');
    if (file && file.name.endsWith('.csv')) {
        const dt = new DataTransfer(); dt.items.add(file); input.files = dt.files;
        updateFileName(input);
    }
}
function confirmDelete(id, name) {
    const modalEl = document.getElementById('deleteModal');
    if (modalEl && modalEl.parentNode !== document.body) {
        document.body.appendChild(modalEl);
    }
    document.getElementById('deleteMsg').innerHTML = `Delete student <strong style="color:var(--text-primary)">${name}</strong>? This action cannot be undone.`;
    document.getElementById('deleteForm').action = '/Students/Delete/' + id;
    new bootstrap.Modal(modalEl).show();
}
function confirmDeleteUser(username) {
    const modalEl = document.getElementById('deleteModal');
    if (modalEl && modalEl.parentNode !== document.body) {
        document.body.appendChild(modalEl);
    }
    document.getElementById('deleteMsg').innerHTML = `Delete faculty member <strong style="color:var(--text-primary)">${username}</strong>? This will also remove the corresponding user account.`;
    document.getElementById('deleteForm').action = '/Students/DeleteUser?username=' + encodeURIComponent(username);
    new bootstrap.Modal(modalEl).show();
}
</script>
}
