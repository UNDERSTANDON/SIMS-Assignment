@model SIMS_WEB.Models.Student
@{
    bool isEdit = !string.IsNullOrEmpty(Model?.StudentId);
    ViewData["Title"] = isEdit ? "Edit Student" : "Add Student";
    ViewData["ActivePage"] = "Students";
    var programs = new[] {
        "Information Technology", "Software Engineering", "Computer Science",
        "Business Administration", "Electrical Engineering", "Applied Mathematics"
    };
}

<div class="sims-page" style="max-width:640px">
    <div class="sims-page-header">
            <h1 class="sims-page-title">
            <i class="fa-solid @(isEdit ? "fa-pen" : "fa-user-plus") fa-sm"></i>
            @(isEdit ? "Edit Student Information" : "Add New Student")
        </h1>
        <a asp-action="Index" class="btn btn-sims-outline">
            <i class="fa-solid fa-arrow-left fa-xs"></i> Back
        </a>
    </div>

    <div class="sims-card">
        <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Student ID</label>
                <input asp-for="StudentId" class="form-control font-mono" readonly
                       style="color:var(--text-secondary) !important; background:var(--bg) !important; cursor:not-allowed;" />
                <div style="font-size:0.72rem;color:var(--text-tertiary);margin-top:0.3rem;font-family:'Geist Mono',monospace;">
                    <i class="fa-solid fa-magic fa-xs"></i> Student ID is auto-generated and cannot be modified
                </div>
                <span asp-validation-for="StudentId" class="invalid-feedback d-block"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Full Name</label>
                <input asp-for="FullName" class="form-control" placeholder="Full Name" />
                <span asp-validation-for="FullName" class="invalid-feedback d-block"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Academic Program</label>
                <select asp-for="Program" class="form-select">
                    <option value="">-- Select Program --</option>
                    @foreach (var p in programs)
                    {
                        <option value="@p">@p</option>
                    }
                </select>
                <span asp-validation-for="Program" class="invalid-feedback d-block"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input asp-for="Email" class="form-control" placeholder="email@univ.edu" />
                <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
            </div>

            <div class="mb-4">
                <label class="form-label">Date of Birth</label>
                <input asp-for="DateOfBirth" type="date" class="form-control" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-sims-primary">
                    <i class="fa-solid fa-floppy-disk fa-xs"></i>
                    @(isEdit ? "Save Changes" : "Add Student")
                </button>
                <a asp-action="Index" class="btn btn-sims-outline">Cancel</a>
            </div>
        </form>
    </div>
</div>
