@model SIMS_WEB.Models.Student
@{
    ViewData["Title"] = "Edit Student";
    ViewData["ActivePage"] = "Students";
    var programs = new[] {
        "Information Technology", "Software Engineering", "Computer Science",
        "Business Administration", "Electrical Engineering", "Applied Mathematics"
    };
}

<div class="sims-page" style="max-width:640px">
    <div class="sims-page-header">
        <h1 class="sims-page-title">
            <i class="fa-solid fa-pen fa-sm"></i>
            Edit Student Information
        </h1>
        <a asp-action="Index" class="btn btn-sims-outline">
            <i class="fa-solid fa-arrow-left fa-xs"></i> Back
        </a>
    </div>

    <div class="sims-card">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">STUDENT ID</label>
                <input asp-for="StudentId" class="form-control font-mono" readonly
                       style="color:var(--text-secondary) !important; background:var(--bg) !important; cursor:not-allowed;" />
                <div style="font-size:0.72rem;color:var(--text-tertiary);margin-top:0.3rem;font-family:'Geist Mono',monospace;">
                    <i class="fa-solid fa-lock fa-xs"></i> Cannot be modified
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">FULL NAME</label>
                <input asp-for="FullName" class="form-control" placeholder="Full Name" />
                <span asp-validation-for="FullName" class="invalid-feedback d-block"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">PROGRAM</label>
                <select asp-for="Program" class="form-select">
                    @foreach (var p in programs)
                    {
                        <option value="@p">@p</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">EMAIL</label>
                <input asp-for="Email" class="form-control" placeholder="email@@univ.edu" />
            </div>
            <div class="mb-4">
                <label class="form-label">DATE OF BIRTH</label>
                <input asp-for="DateOfBirth" type="date" class="form-control" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-sims-primary">
                    <i class="fa-solid fa-floppy-disk fa-xs"></i> Save Changes
                </button>
                <a asp-action="Index" class="btn btn-sims-outline">Cancel</a>
            </div>
        </form>
    </div>
</div>
