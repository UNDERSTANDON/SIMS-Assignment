@model SIMS_WEB.Models.Course
@{
    bool isEdit = !string.IsNullOrEmpty(Model?.Code);
    ViewData["Title"] = isEdit ? "Sửa Khóa học" : "Thêm Khóa học";
    ViewData["ActivePage"] = "Courses";
}

<div class="sims-page" style="max-width:640px">
    <div class="sims-page-header">
            <h1 class="sims-page-title">
            <i class="fa-solid @(isEdit ? "fa-pen" : "fa-plus") fa-sm"></i>
            @(isEdit ? "Sửa Khóa học" : "Thêm Khóa học mới")
        </h1>
        <a asp-action="Index" class="btn btn-sims-outline">
            <i class="fa-solid fa-arrow-left fa-xs"></i> Quay lại
        </a>
    </div>

    <div class="sims-card">
        <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Code" class="form-label"></label>
                @if (isEdit) {
                    <input asp-for="Code" class="form-control font-mono" readonly style="color:var(--text-secondary) !important; background:var(--bg) !important; cursor:not-allowed;" />
                } else {
                    <input asp-for="Code" class="form-control font-mono" placeholder="VD: CS101" />
                }
                <span asp-validation-for="Code" class="invalid-feedback d-block"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" placeholder="VD: Lập trình Cơ bản" />
                <span asp-validation-for="Title" class="invalid-feedback d-block"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Capacity" class="form-label"></label>
                <input asp-for="Capacity" type="number" class="form-control font-mono" min="1" max="500" />
                <span asp-validation-for="Capacity" class="invalid-feedback d-block"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Instructor" class="form-label"></label>
                <input asp-for="Instructor" class="form-control" placeholder="VD: Nguyễn Văn A" list="lecturerList" autocomplete="off" />
                <datalist id="lecturerList">
                    @foreach (var l in ViewBag.Lecturers as List<SIMS_Assignment.Models.User> ?? new())
                    {
                        var name = !string.IsNullOrEmpty(l.FullName) ? l.FullName : l.Name;
                        <option value="@name">@name (@l.Name)</option>
                    }
                </datalist>
            </div>
            <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-sims-success">
                    <i class="fa-solid fa-floppy-disk fa-xs"></i>
                    @(isEdit ? "Lưu thay đổi" : "Thêm khóa học")
                </button>
                <a asp-action="Index" class="btn btn-sims-outline">Hủy</a>
            </div>
        </form>
    </div>
</div>
