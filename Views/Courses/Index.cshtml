@model List<SIMS_WEB.Models.Course>
@{
    ViewData["Title"] = "Quản lý Khóa học";
    ViewData["ActivePage"] = "Courses";
}

<div class="sims-page">
    <div class="sims-page-header">
        <h1 class="sims-page-title">
            <i class="fa-solid fa-book fa-sm"></i>
            Qu?n lý Khóa học
            <span class="sims-badge badge-success ms-2 font-mono">@ViewBag.Total</span>
        </h1>
        <a asp-action="Create" class="btn btn-sims-success">
            <i class="fa-solid fa-plus fa-xs"></i> Thêm khóa học
        </a>
    </div>
    
    @if (!Model.Any())
    {
        <div class="sims-card">
            <div class="sims-empty">
                <i class="fa-solid fa-book-open"></i>
                <div class="em-title">Chưa có khóa học nào</div>
                <div class="em-sub">Tạo khóa học đầu tiên để bắt đầu.</div>
            </div>
        </div>
    }
    else
    {
        <div class="sims-table-wrap">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Khóa học</th>
                        <th>Mã môn</th>
                        <th>Giảng viên</th>
                        <th>Sỉ số</th>
                        <th style="min-width:130px">Tỷ lệ đăng ký</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        var pct = c.CapacityPercent;
                        var barClass = pct >= 100 ? "danger" : pct >= 80 ? "warning" : "";
                        var statusBadge = c.IsFull ? "badge-danger" : pct >= 80 ? "badge-warning" : "badge-success";
                        var statusText  = c.IsFull ? "Đầy" : pct >= 80 ? "Sắp đầy" : "Còn chỗ";
                        <tr>
                            <td style="font-weight:600">@c.Title</td>
                            <td><code class="font-mono" style="color:#4ade80;font-size:0.8rem">@c.Code</code></td>
                            <td style="color:var(--text-tertiary);font-size:0.8rem">@c.Instructor</td>
                            <td>
                                <span class="font-mono" style="font-size:0.875rem">@c.EnrolledCount/@c.Capacity</span>
                                <span class="sims-badge @statusBadge ms-1">@statusText</span>
                            </td>
                            <td>
                                <div class="sims-progress mb-1">
                                    <div class="sims-progress-bar @barClass" style="width:@pct%"></div>
                                </div>
                                <span class="fs-xs text-muted-sims font-mono">@pct%</span>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Edit" asp-route-id="@c.Code"
                                       class="btn btn-sims-outline btn-sm py-1 px-2">
                                        <i class="fa-solid fa-pen fa-xs"></i>
                                    </a>
                                    <button class="btn btn-sims-danger btn-sm py-1 px-2"
                                            onclick="confirmDelete('@c.Code','@c.Title')">
                                        <i class="fa-solid fa-trash fa-xs"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-body p-4">
                <div style="width:40px;height:40px;background:var(--warning-muted);border-radius:var(--r-md);display:flex;align-items:center;justify-content:center;margin-bottom:1rem;">
                    <i class="fa-solid fa-triangle-exclamation" style="color:#fbbf24;font-size:1rem;"></i>
                </div>
                <div style="font-weight:700;font-size:0.95rem;margin-bottom:0.4rem;">Xác nh?n xóa khóa học</div>
                <div id="deleteMsg" style="font-size:0.8rem;color:var(--text-tertiary);margin-bottom:1.25rem;"></div>
                <div class="d-flex gap-2">
                    <form id="deleteForm" method="post" class="flex-grow-1">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sims-danger w-100">Xóa</button>
                    </form>
                    <button class="btn btn-sims-outline" data-bs-dismiss="modal">Hủy</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function confirmDelete(id, title) {
    const modalEl = document.getElementById('deleteModal');
    // ensure modal is attached to document.body so Bootstrap backdrop/z-index behave correctly
    if (modalEl && modalEl.parentNode !== document.body) {
        document.body.appendChild(modalEl);
    }
    document.getElementById('deleteMsg').innerHTML =
        `Xóa khóa học <strong style="color:var(--text-primary)">${title}</strong>?<br/>
        <span style="color:#fbbf24;font-size:0.75rem;">Không thể xóa nếu đang có sinh viên đăng ký.</span>`;
    document.getElementById('deleteForm').action = '/Courses/Delete/' + id;
    new bootstrap.Modal(modalEl).show();
}
</script>
}
